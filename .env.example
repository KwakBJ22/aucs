# 이름만 적습니다. 값은 .env 에만 넣고 저장소에 올리지 않습니다.

# Supabase (서울)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# API(FastAPI)가 DB에 붙을 때 쓰는 주소 (Supabase → Connect → Session pooler)
DATABASE_URL=

# 웹(Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 공공 자료
DATA_GO_KR_SERVICE_KEY=
VWORLD_API_KEY=

# 카카오 (로그인·지도) — 2단계
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# 오류 알림 — 필요할 때
SENTRY_DSN=

# 관리자 화면 열쇠 (개발용, 2단계 로그인 전까지)
ADMIN_TOKEN=

# 웹 푸시 (VAPID)
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
